					<AskRebuildNeeded command="" />
					<SilentBuild command="make  MCU=atmega2560  LCD=KS108 &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
